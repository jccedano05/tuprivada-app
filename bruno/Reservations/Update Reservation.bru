meta {
  name: Update Reservation
  type: http
  seq: 2
}

put {
  url: {{base_url}}/api/reservations/:id
  body: json
  auth: bearer
}

params:path {
  id: 1
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "reservationDate": "2026-02-16",
    "startTime": "14:00:00",
    "endTime": "16:00:00",
    "notes": "Cambio de horario"
  }
}
