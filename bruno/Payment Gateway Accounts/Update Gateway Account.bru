meta {
  name: Update Gateway Account
  type: http
  seq: 2
}

put {
  url: {{base_url}}/api/{{api_version}}/payment-gateway/accounts/:accountId
  body: json
  auth: bearer
}

params:path {
  accountId: 1
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "publicKey": "key_new_xxxxxxxxxxxxxx",
    "privateKey": "key_new_xxxxxxxxxxxxxx",
    "isActive": true,
    "commissionPercentage": 3.5
  }
}
